# Copy to .env.local and fill in from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: never expose to the client. Used for admin/service_role tasks
# (e.g. Stripe webhook handlers writing to organization_subscriptions).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only: never exposed to the client (see src/lib/email/provider.ts).
# The Print/Export/Email toolbar and Profile Sharing are only able to
# actually send when BOTH RESEND_API_KEY and EMAIL_FROM are set -- see
# docs/EMAIL_SETUP.md for how to get real values for these.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Truck Dispatch Pro <billing@yourdomain.com>
EMAIL_REPLY_TO=accounts@yourdomain.com

# Public site URL -- consumed by onboarding email links AND (as a dev
# fallback) the QuickBooks OAuth redirect URI. Must be the real deployed
# https URL in production, never localhost.
NEXT_PUBLIC_SITE_URL=https://truck-dispatch-pro.vercel.app

# QuickBooks Online (Intuit) OAuth 2.0 -- SERVER-ONLY. Never NEXT_PUBLIC_*.
# Use SANDBOX / Development app credentials for this phase. The token
# encryption key is NOT here -- it is generated inside migration
# 0116_quickbooks_oauth_foundation.sql (app_encryption_keys.quickbooks_token_key).
QUICKBOOKS_CLIENT_ID=your-intuit-sandbox-client-id
QUICKBOOKS_CLIENT_SECRET=your-intuit-sandbox-client-secret
QUICKBOOKS_ENVIRONMENT=sandbox
# Must match EXACTLY what is registered in the Intuit Developer portal:
QUICKBOOKS_REDIRECT_URI=https://truck-dispatch-pro.vercel.app/api/integrations/quickbooks/callback

# Stripe -- Truck Dispatch Pro's OWN SaaS subscription billing (our
# subscription revenue). SEPARATE from the QuickBooks tenant accounting
# integration above and from freight invoices/payments. SERVER-ONLY --
# never NEXT_PUBLIC_*, and there is no publishable key (hosted Checkout +
# Customer Portal only). Use SANDBOX / TEST-mode credentials this phase;
# a test secret key looks like sk_test_... . Success/cancel redirect URLs
# are built from NEXT_PUBLIC_SITE_URL (above), not configured here.
STRIPE_SECRET_KEY=
# Signing secret for the Stripe webhook endpoint (whsec_...), copied from
# the endpoint's configuration in the Stripe Dashboard. Created in a later
# phase -- may remain unset until the webhook endpoint exists.
STRIPE_WEBHOOK_SECRET=

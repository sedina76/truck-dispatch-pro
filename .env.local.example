# Copy to .env.local and fill in from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: never expose to the client. Used for admin/service_role tasks
# (e.g. Stripe webhook handlers writing to organization_subscriptions).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only: never exposed to the client (see src/lib/email/provider.ts).
# The Print/Export/Email toolbar and Profile Sharing are only able to
# actually send when BOTH RESEND_API_KEY and EMAIL_FROM are set -- see
# docs/EMAIL_SETUP.md for how to get real values for these.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Truck Dispatch Pro <billing@yourdomain.com>
EMAIL_REPLY_TO=accounts@yourdomain.com
